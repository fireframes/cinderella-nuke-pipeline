# =============================================================================
# Shot Manager Pipeline Backend — environment configuration
# Copy this file to .env and fill in values for your studio.
# Lines marked [REQUIRED] must be set before starting the server.
# Lines marked [OPTIONAL] have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Server paths  [REQUIRED]
# -----------------------------------------------------------------------------

# Root of the render tree.  The scanner walks this path looking for shots.
RENDER_PATH=//192.168.1.100/prj/show/render

# Root of the comp tree.  Scripts, EXRs, MOVs and thumbnails are written here.
COMP_PATH=//192.168.1.100/prj/show/comp

# Current alembic / cache location (used for shot_camera.abc lookup).
CACHE_PATH_NEW=//192.168.1.100/prj/show/cache

# Legacy cache location (fallback if camera is not found in CACHE_PATH_NEW).
CACHE_PATH_OLD=//192.168.1.100/prj/show/cache_old

# -----------------------------------------------------------------------------
# Shot naming convention  [OPTIONAL — defaults match ep/sq/sh layout]
# -----------------------------------------------------------------------------

# Regex applied to paths relative to RENDER_PATH.
# Must use named groups that match the placeholders in SHOT_ID_FORMAT and
# SHOT_DIR_FORMAT.  Default matches: ep01/sq05/sh001
#SHOT_PATTERN=ep(?P<ep>\d+)[/\\]sq(?P<sq>\d+)[/\\]sh(?P<sh>\d+)

# Template for the canonical shot identifier.
#SHOT_ID_FORMAT=ep{ep}_sq{sq}_sh{sh}

# Template for the shot sub-path inside RENDER_PATH / COMP_PATH.
#SHOT_DIR_FORMAT=ep{ep}/sq{sq}/sh{sh}

# Named group that maps to "episode" in the shot model (must be in SHOT_PATTERN).
#SHOT_EP_GROUP=ep

# Named group that maps to "sequence" in the shot model.
#SHOT_SQ_GROUP=sq

# Named group that maps to "shot" in the shot model.
#SHOT_SH_GROUP=sh

# Number of directory levels to scan below RENDER_PATH.
# Must match the depth of SHOT_PATTERN (3 for the default ep/sq/sh pattern).
#SHOT_SCAN_DEPTH=3

# Sub-directory inside each shot dir that holds render layers (EXR files).
#SHOT_RENDER_SUBDIR=render

# Camera file lookup within the cache tree.
#SHOT_CAM_SUBDIR=src
#SHOT_CAM_FILENAME=shot_camera.abc

# -----------------------------------------------------------------------------
# Production tracker  [OPTIONAL — all /tracker endpoints return 503 if not set]
# Supported backends: shotgrid, ftrack
# -----------------------------------------------------------------------------

# Which tracker to enable.  Leave empty to disable tracker endpoints.
# Supported values: shotgrid, ftrack, cerebro
#TRACKER_BACKEND=shotgrid

# Tracker server URL.
#   ShotGrid: https://mystudio.shotgrid.autodesk.com
#   ftrack:   https://mystudio.ftrackapp.com
#TRACKER_URL=https://mystudio.shotgrid.autodesk.com

# Script / bot credentials.
#   ShotGrid: script name from Admin > Scripts
#   ftrack:   API user email
#TRACKER_SCRIPT_NAME=pipeline_bot

# API key for the script / bot user.
#TRACKER_API_KEY=your_api_key_here

# Project name exactly as it appears in the tracker.
#TRACKER_PROJECT=MyShow

# Optional: only return tasks of this step / type (e.g. "Comp").
# Leave empty to return all tasks linked to a shot.
#TRACKER_TASK_TYPE=Comp

# -----------------------------------------------------------------------------
# Cerebro  [used when TRACKER_BACKEND=cerebro]
# -----------------------------------------------------------------------------

#CEREBRO_SERVER=cerebro.studio.local
#CEREBRO_CARGADOR_ADDRESS=cargador.studio.local
#CEREBRO_CARGADOR_NATIVE_PORT=7779
#CEREBRO_CARGADOR_HTTP_PORT=7780

# Path to a JSON file: {"name": "artist_login", "pass": "password"}
#CEREBRO_ACCOUNT_PATH=/secrets/cerebro_account.json

# Template for building the Cerebro task URL from shot groups (int-formatted).
#CEREBRO_TASK_URL_TEMPLATE=/MyShow/Prod/ep{ep:02d}/sq{sq:02d}/sh{sh:03d}/compos

# -----------------------------------------------------------------------------
# Nuke script templates  [OPTIONAL]
# -----------------------------------------------------------------------------

# Path to a .nk template file for comp scripts.
# If unset, a minimal stub .nk is created instead.
#TEMPLATE_COMP_PATH=/tools/templates/comp_template.nk

# Path to a .nk template file for light precomp scripts.
# The template should contain Read nodes whose file paths reference layer names,
# and Write nodes whose file paths end in .exr or .mov.
# The backend patches these paths automatically when creating v01 precomps.
#TEMPLATE_PRECOMP_PATH=/tools/templates/precomp_template.nk

# -----------------------------------------------------------------------------
# Thumbnail generation  [OPTIONAL]
# -----------------------------------------------------------------------------

# Seek position (seconds from start) used when extracting a thumbnail frame.
#THUMBNAIL_SEEK_TIME=0.5

# Fallback seek time used when the video is shorter than THUMBNAIL_SEEK_TIME.
#THUMBNAIL_FALLBACK_SEEK=0.1

# -----------------------------------------------------------------------------
# Shot-list cache  [OPTIONAL]
# -----------------------------------------------------------------------------

# How long the shot-list JSON cache is considered fresh (hours).
#SHOT_CACHE_TTL_HOURS=1

# Directory where the shot-list cache file is written.
# Defaults to /tmp if unset.
#SHOT_CACHE_PATH=/tmp
